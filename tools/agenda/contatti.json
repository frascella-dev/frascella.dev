{
  "key": "contatti",
  "title": {
    "it": "Contatti",
    "en": "Contact"
  },
  "languages": [
    "it",
    "en"
  ],
  "default_language": "it",
  "routing": {
    "mode": "query",
    "root": "show",
    "done_slug": {
      "it": "inviato",
      "en": "sent"
    }
  },
  "seo": {
    "noindex_done": true
  },
  "spam": {
    "honeypot": "website",
    "min_seconds": 2,
    "contact_cooldown_minutes": 15
  },
  "retention": {
    "days": 365
  },
  "labels": {
    "submit": {
      "it": "Invia il messaggio →",
      "en": "Send message →"
    }
  },
  "messages": {
    "status": {
      "invalid": {
        "it": "Controlla i campi segnati.",
        "en": "Check the highlighted fields."
      },
      "failed": {
        "it": "Il messaggio non è partito. Riprova tra qualche minuto o scrivimi a emanuele@frascella.dev.",
        "en": "The message didn’t go through. Try again in a few minutes, or email me at emanuele@frascella.dev."
      },
      "rate_limited": {
        "it": "Il messaggio non è partito. Riprova tra qualche minuto o scrivimi a emanuele@frascella.dev.",
        "en": "The message didn’t go through. Try again in a few minutes, or email me at emanuele@frascella.dev."
      },
      "cooldown": {
        "it": "Ho già ricevuto un messaggio da questo indirizzo pochi minuti fa: ti rispondo a quello.",
        "en": "A message from this address arrived a few minutes ago. I’ll reply to that one."
      }
    }
  },
  "summary": {
    "fields": [
      "name",
      "email",
      "company",
      "message"
    ],
    "subject": "Messaggio da {{name}}"
  },
  "done": {
    "title": {
      "it": "Messaggio ricevuto.",
      "en": "Message received."
    },
    "body": {
      "it": "Ti rispondo entro due giorni lavorativi.",
      "en": "I’ll get back to you within two working days."
    }
  },
  "steps": [
    {
      "key": "message",
      "slug": "message",
      "name": {
        "it": "scrivimi",
        "en": "contact"
      },
      "title": {
        "it": "Scrivimi",
        "en": "Contact"
      },
      "fields": [
        {
          "key": "name",
          "type": "text",
          "role": "customer.given_name",
          "autocomplete": "name",
          "required": true,
          "label": {
            "it": "Nome",
            "en": "Name"
          },
          "rules": {
            "max_length": 120
          },
          "messages": {
            "required": {
              "it": "Scrivi il tuo nome.",
              "en": "Enter your name."
            }
          }
        },
        {
          "key": "email",
          "type": "email",
          "role": "customer.email",
          "autocomplete": "email",
          "required": true,
          "label": "Email",
          "rules": {
            "max_length": 190
          },
          "messages": {
            "required": {
              "it": "L’indirizzo email non sembra valido.",
              "en": "Check the email address. It doesn’t look valid."
            },
            "invalid": {
              "it": "L’indirizzo email non sembra valido.",
              "en": "Check the email address. It doesn’t look valid."
            }
          }
        },
        {
          "key": "company",
          "type": "text",
          "autocomplete": "organization",
          "required": false,
          "label": {
            "it": "Azienda (facoltativo)",
            "en": "Company (optional)"
          },
          "rules": {
            "max_length": 160
          }
        },
        {
          "key": "message",
          "type": "textarea",
          "required": true,
          "rows": 4,
          "label": {
            "it": "Messaggio",
            "en": "Message"
          },
          "placeholder": {
            "it": "Es. un’app per i nostri agenti commerciali, collegata al gestionale, da lanciare entro marzo",
            "en": "E.g. an app for our sales reps, connected to our ERP, live by March"
          },
          "rules": {
            "max_length": 5000
          },
          "messages": {
            "required": {
              "it": "Scrivi due righe su cosa ti serve.",
              "en": "Write a couple of lines about what you need."
            }
          }
        },
        {
          "key": "privacy_note",
          "type": "content",
          "html": {
            "it": "Uso i dati del modulo solo per risponderti. Cosa ne faccio e per quanto li tengo: <a href=\"/privacy/\">privacy</a>.",
            "en": "I use the form’s data only to reply to you. What I do with it and how long I keep it: <a href=\"/en/privacy/\">privacy</a>."
          }
        }
      ]
    }
  ]
}
