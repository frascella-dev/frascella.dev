{
  "key": "contatti",
  "title": {
    "it": "Contatti",
    "en": "Contact"
  },
  "languages": [
    "it",
    "en"
  ],
  "default_language": "it",
  "routing": {
    "mode": "query",
    "root": "show",
    "done_slug": {
      "it": "inviato",
      "en": "sent"
    }
  },
  "seo": {
    "noindex_done": true
  },
  "spam": {
    "honeypot": "website",
    "min_seconds": 2,
    "contact_cooldown_minutes": 15
  },
  "retention": {
    "days": 365
  },
  "labels": {
    "submit": {
      "it": "Invia il messaggio →",
      "en": "Invia il messaggio →"
    }
  },
  "messages": {
    "status": {
      "invalid": {
        "it": "Controlla i campi segnati.",
        "en": "Controlla i campi segnati."
      },
      "failed": {
        "it": "Il messaggio non è partito. Riprova tra qualche minuto o scrivimi a emanuele@frascella.dev.",
        "en": "Il messaggio non è partito. Riprova tra qualche minuto o scrivimi a emanuele@frascella.dev."
      },
      "rate_limited": {
        "it": "Il messaggio non è partito. Riprova tra qualche minuto o scrivimi a emanuele@frascella.dev.",
        "en": "Il messaggio non è partito. Riprova tra qualche minuto o scrivimi a emanuele@frascella.dev."
      },
      "cooldown": {
        "it": "Ho già ricevuto un messaggio da questo indirizzo pochi minuti fa: ti rispondo a quello.",
        "en": "Ho già ricevuto un messaggio da questo indirizzo pochi minuti fa: ti rispondo a quello."
      }
    }
  },
  "summary": {
    "fields": [
      "name",
      "email",
      "company",
      "message"
    ],
    "subject": "Messaggio da {{name}}"
  },
  "done": {
    "title": {
      "it": "Messaggio ricevuto.",
      "en": "Messaggio ricevuto."
    },
    "body": {
      "it": "Ti rispondo entro due giorni lavorativi.",
      "en": "Ti rispondo entro due giorni lavorativi."
    }
  },
  "steps": [
    {
      "key": "message",
      "slug": "message",
      "name": {
        "it": "scrivimi",
        "en": "scrivimi"
      },
      "title": {
        "it": "Scrivimi",
        "en": "Scrivimi"
      },
      "fields": [
        {
          "key": "name",
          "type": "text",
          "role": "customer.given_name",
          "autocomplete": "name",
          "required": true,
          "label": {
            "it": "Nome",
            "en": "Nome"
          },
          "rules": {
            "max_length": 120
          },
          "messages": {
            "required": {
              "it": "Scrivi il tuo nome.",
              "en": "Scrivi il tuo nome."
            }
          }
        },
        {
          "key": "email",
          "type": "email",
          "role": "customer.email",
          "autocomplete": "email",
          "required": true,
          "label": "Email",
          "rules": {
            "max_length": 190
          },
          "messages": {
            "required": {
              "it": "L’indirizzo email non sembra valido.",
              "en": "L’indirizzo email non sembra valido."
            },
            "invalid": {
              "it": "L’indirizzo email non sembra valido.",
              "en": "L’indirizzo email non sembra valido."
            }
          }
        },
        {
          "key": "company",
          "type": "text",
          "autocomplete": "organization",
          "required": false,
          "label": {
            "it": "Azienda (facoltativo)",
            "en": "Azienda (facoltativo)"
          },
          "rules": {
            "max_length": 160
          }
        },
        {
          "key": "message",
          "type": "textarea",
          "required": true,
          "rows": 4,
          "label": {
            "it": "Messaggio",
            "en": "Messaggio"
          },
          "placeholder": {
            "it": "Es. un’app per i nostri agenti commerciali, collegata al gestionale, da lanciare entro marzo",
            "en": "Es. un’app per i nostri agenti commerciali, collegata al gestionale, da lanciare entro marzo"
          },
          "rules": {
            "max_length": 5000
          },
          "messages": {
            "required": {
              "it": "Scrivi due righe su cosa ti serve.",
              "en": "Scrivi due righe su cosa ti serve."
            }
          }
        },
        {
          "key": "privacy_note",
          "type": "content",
          "html": {
            "it": "Uso i dati del modulo solo per risponderti. Cosa ne faccio e per quanto li tengo: <a href=\"/privacy/\">privacy</a>.",
            "en": "Uso i dati del modulo solo per risponderti. Cosa ne faccio e per quanto li tengo: <a href=\"/en/privacy/\">privacy</a>."
          }
        }
      ]
    }
  ]
}
