{
    "$comment": "The one source of the palette and the type. Vite writes it as CSS custom properties (assets/src/css/tokens.generated.css), the plugin writes it into Elementor's Kit, and inc/tokens.php gives it to every plugin that sends email. Change it here, nowhere else.",
    "colors": {
        "ground": { "value": "#f7f6f2", "label": "Ground" },
        "surface": { "value": "#ffffff", "label": "Surface" },
        "text": { "value": "#1b1b1a", "label": "Text" },
        "soft": { "value": "#4b4a46", "label": "Soft text" },
        "meta": { "value": "#6f6d67", "label": "Meta" },
        "rule": { "value": "#dcdad2", "label": "Rule" },
        "accent": { "value": "#1f3a5f", "label": "Accent" },
        "accentText": { "value": "#ffffff", "label": "Text on accent" },
        "dark": { "value": "#1b1b1a", "label": "Dark surface" },
        "onDark": { "value": "#f7f6f2", "label": "Text on dark" },
        "alert": { "value": "#b3261e", "label": "Alert" }
    },
    "fonts": {
        "heading": { "family": "Georgia", "stack": "Georgia, 'Times New Roman', serif", "weight": "400", "label": "Headings" },
        "body": { "family": "system-ui", "stack": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "weight": "400", "label": "Body" }
    },
    "radius": "0px",
    "kit": {
        "colors": { "primary": "text", "secondary": "ground", "text": "text", "accent": "accent" },
        "typography": { "primary": "heading", "secondary": "body", "text": "body", "accent": "body" }
    },
    "email": {
        "background": "ground",
        "surface": "surface",
        "text": "text",
        "muted": "meta",
        "accent": "accent",
        "accent_text": "accentText",
        "link": "accent",
        "border": "rule",
        "font_body": "body",
        "font_heading": "heading"
    }
}
