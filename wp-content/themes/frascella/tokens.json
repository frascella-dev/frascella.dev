{
    "$comment": "The one source of the palette and the type. Vite writes it as CSS custom properties (assets/src/css/tokens.generated.css), the plugin writes it into Elementor's Kit, and inc/tokens.php gives it to every plugin that sends email. Change it here, nowhere else. The palette is the Sketch file's (frascella.dev → Colors): Ink, Graphite, Paper, Stone, Vermilion; `soft` and `meta` are Paper and Stone lifted for running text and small text on Ink (contrast 13:1 and 6.4:1).",
    "colors": {
        "ground": { "value": "#0E0E11", "label": "Ink" },
        "surface": { "value": "#1C1C21", "label": "Graphite" },
        "text": { "value": "#F3EFE7", "label": "Paper" },
        "soft": { "value": "#DDD8CF", "label": "Running text" },
        "meta": { "value": "#A7A197", "label": "Small text" },
        "stone": { "value": "#8A857C", "label": "Stone" },
        "rule": { "value": "#34332F", "label": "Rule" },
        "accent": { "value": "#FF4A1C", "label": "Vermilion" },
        "accentText": { "value": "#0E0E11", "label": "Text on vermilion" },
        "dark": { "value": "#0E0E11", "label": "Dark surface" },
        "onDark": { "value": "#F3EFE7", "label": "Text on dark" },
        "alert": { "value": "#FF8A6B", "label": "Alert" }
    },
    "fonts": {
        "heading": { "family": "Gloock", "stack": "Gloock, Georgia, 'Times New Roman', serif", "weight": "400", "label": "Gloock" },
        "body": { "family": "Schibsted Grotesk", "stack": "'Schibsted Grotesk', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "weight": "400", "label": "Schibsted Grotesk" }
    },
    "radius": "0px",
    "kit": {
        "colors": { "primary": "text", "secondary": "ground", "text": "soft", "accent": "accent" },
        "typography": { "primary": "heading", "secondary": "body", "text": "body", "accent": "body" }
    },
    "email": {
        "background": "text",
        "surface": "text",
        "text": "ground",
        "muted": "stone",
        "accent": "accent",
        "accent_text": "accentText",
        "link": "ground",
        "border": "stone",
        "font_body": "body",
        "font_heading": "heading"
    }
}
