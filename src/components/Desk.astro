---
/**
 * The intermezzo: two screens of bare desk, with a dot on each thing that can be touched.
 * The two holds keep the camera at the same station for a screen; the scene moves each
 * hotspot onto its object and shows it once the sheet has lifted (src/desk/CONTRACT.md §3).
 *
 * The dots are decorative: hidden from screen readers and out of the Tab order, clickable
 * with a mouse or a finger. The keyboard reaches the same objects through the header's desk
 * switches (`.scene-ctl`), each named for what it does.
 *
 * The scroll cue and the tablet's bar sit here too: fixed on screen, and in the reading
 * order right after the opening, which is where they are used.
 */
import { words, type Lang } from "../i18n.ts";

interface Props {
    lang: Lang;
}
const w = words[Astro.props.lang];
const spots = ["lamp", "turntable", "mug", "ipad", "phone", "plant", "owl"];
---
<button class="cue" id="cue" type="button" aria-label={w.desk.cue}><span aria-hidden="true">{w.desk.cue}</span><svg viewBox="0 0 16 50" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path class="sh" pathLength="1" d="M8 1v47"/><path d="M3 43l5 5 5-5"/></svg></button>
<section class="desk-int" id="scrivania" aria-label={w.desk.label}>
    <div class="hold" data-stop="desk"></div>
    <div class="hold" data-stop="desk"></div>
    <div class="hotspots" id="hotspots" aria-hidden="true">
        {spots.map((key) => <button class="hs" type="button" data-hs={key} tabindex="-1"><span class="dot"></span></button>)}
    </div>
</section>
<div class="pad-ui" id="pad-ui" hidden>
    <p class="pad-hint" role="status">{w.desk.padHint}</p>
</div>
