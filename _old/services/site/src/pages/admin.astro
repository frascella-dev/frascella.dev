---
// The dashboard. Same tokens as the portfolio, none of its behaviour: no
// splash, no fluid, no corridor, no custom cursor (`bare`), and kept out of
// search results (`noindex`, plus robots.txt).
//
// The markup here is the skeleton only — every number, bar and row is filled
// in by `lib/admin.ts` from one request. Nothing sensitive is in the HTML,
// which is why it is safe for this page to be a static file like any other:
// without the session cookie the API answers 401 and the page stays empty.
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import { owner } from "../data/site.ts";

const RANGES = [
    { days: 7, label: "7 days" },
    { days: 30, label: "30 days" },
    { days: 90, label: "90 days" },
    { days: 365, label: "12 months" },
];

// Left column is the headline, right column is the same number for the
// window before this one — every tile carries its own comparison.
const TILES = [
    { key: "visitors", label: "visitors", hint: "distinct browsers" },
    { key: "sessions", label: "visits", hint: "30-minute sessions" },
    { key: "newVisitors", label: "new", hint: "first time here" },
    { key: "avgDurationSec", label: "avg. visit", hint: "time on the page", unit: "s" },
    { key: "avgScroll", label: "avg. depth", hint: "how far down", unit: "%" },
    { key: "bounceRate", label: "bounced", hint: "left above 25%, under 15s", unit: "%" },
    { key: "contacts", label: "messages", hint: "form sent" },
    { key: "contactRate", label: "conversion", hint: "visits that wrote", unit: "%" },
];

const BREAKDOWNS = [
    { key: "referrers", title: "Where they came from", head: "source" },
    { key: "devices", title: "Device", head: "kind" },
    { key: "browsers", title: "Browser", head: "name" },
    { key: "systems", title: "System", head: "name" },
    { key: "countries", title: "Country", head: "code" },
    { key: "languages", title: "Language", head: "tag" },
];
---

<Base bare noindex title={`Dashboard — ${owner.name}`} description="Private.">
    <main class="adm">
        <!--
          Sign in, in two steps on one form. The password buys a session that
          is deliberately useless until the second factor lands, so the second
          step is not a courtesy — `lib/admin.ts` moves between them, and the
          API refuses every route until the code has been answered.
        -->
        <section data-admin-login class="adm-login" hidden>
            <!--
              `novalidate` is load-bearing, not a style preference. The two
              steps are one form, so at the second step the email and password
              fields are `required`, empty (the password is wiped once it has
              been spent) and inside a `hidden` panel. Chrome refuses to submit
              a form with an invalid control it cannot focus — silently, with
              no request and nothing on screen. The API validates either way
              and answers 422, which is where the message comes from.
            -->
            <form data-admin-login-form class="adm-login-form" novalidate>
                <h1 class="adm-login-title">dashboard</h1>

                <div data-step="password" class="adm-login-step">
                    <label class="adm-login-field">
                        <span class="label">email</span>
                        <input
                            data-admin-email
                            type="email"
                            name="email"
                            autocomplete="username"
                            required
                        />
                    </label>
                    <label class="adm-login-field">
                        <span class="label">password</span>
                        <input
                            data-admin-password
                            type="password"
                            name="password"
                            autocomplete="current-password"
                            required
                        />
                    </label>
                </div>

                <div data-step="code" class="adm-login-step" hidden>
                    <p class="adm-login-hint">
                        Six digits from your authenticator — or one of your recovery codes.
                    </p>
                    <label class="adm-login-field">
                        <span class="label">code</span>
                        <input
                            data-admin-code
                            name="code"
                            type="text"
                            inputmode="numeric"
                            autocomplete="one-time-code"
                            autocorrect="off"
                            spellcheck="false"
                        />
                    </label>
                </div>

                <button data-admin-submit type="submit">continue</button>
                <p data-admin-login-error class="adm-login-error" role="status" aria-live="polite"></p>
                <button data-admin-restart type="button" class="adm-login-back" hidden>
                    start again
                </button>
            </form>
        </section>

        <section data-admin-dash class="adm-dash" hidden>
            <header class="adm-head">
                <div>
                    <h1 class="adm-title">dashboard</h1>
                    <p data-admin-range-label class="label adm-subtitle"></p>
                </div>

                <div class="adm-controls">
                    <div data-admin-ranges class="adm-ranges">
                        {RANGES.map((r) => (
                            <button type="button" data-range={r.days}>{r.label}</button>
                        ))}
                    </div>
                    <button data-admin-refresh type="button" class="adm-ghost">refresh</button>
                    <button data-admin-logout type="button" class="adm-ghost">sign out</button>
                </div>
            </header>

            <div data-admin-error class="adm-error" role="status" aria-live="polite" hidden></div>

            <div class="adm-tiles">
                {TILES.map((t) => (
                    <div class="adm-tile">
                        <div class="label adm-tile-label">{t.label}</div>
                        <div class="adm-tile-value" data-tile={t.key} data-unit={t.unit ?? ""}>—</div>
                        <div class="adm-tile-foot">
                            <span data-tile-delta={t.key} class="adm-delta"></span>
                            <span class="adm-tile-hint">{t.hint}</span>
                        </div>
                    </div>
                ))}
            </div>

            <div class="adm-panel">
                <div class="adm-panel-head">
                    <h2>Visits over time</h2>
                    <div class="adm-legend">
                        <span class="adm-key adm-key-sessions">visits</span>
                        <span class="adm-key adm-key-visitors">visitors</span>
                    </div>
                </div>
                <div data-chart-series class="adm-chart"></div>
            </div>

            <div class="adm-columns">
                <div class="adm-panel">
                    <div class="adm-panel-head"><h2>How far they read</h2></div>
                    <div data-chart-scroll class="adm-bars"></div>
                </div>

                <div class="adm-panel">
                    <div class="adm-panel-head"><h2>The contact funnel</h2></div>
                    <div data-chart-funnel class="adm-bars"></div>
                </div>
            </div>

            <div class="adm-panel">
                <div class="adm-panel-head"><h2>Sections</h2></div>
                <div data-table-sections class="adm-table"></div>
            </div>

            <div class="adm-panel">
                <div class="adm-panel-head"><h2>Time of day</h2></div>
                <div data-chart-hours class="adm-chart adm-chart-short"></div>
            </div>

            <div class="adm-columns adm-columns-3">
                {BREAKDOWNS.map((b) => (
                    <div class="adm-panel">
                        <div class="adm-panel-head"><h2>{b.title}</h2></div>
                        <div data-table-breakdown={b.key} data-head={b.head} class="adm-table"></div>
                    </div>
                ))}
            </div>

            <div class="adm-panel">
                <div class="adm-panel-head"><h2>What they did</h2></div>
                <div data-table-interactions class="adm-table"></div>
            </div>

            <div class="adm-panel">
                <div class="adm-panel-head"><h2>Recent visits</h2></div>
                <div data-table-recent class="adm-table adm-table-wide"></div>
            </div>

            <Footer />
        </section>
    </main>

    <script>
        import { initAdmin } from "../lib/admin.ts";
        initAdmin();
    </script>
</Base>

<style is:global>
    /* A control room, not the portfolio: ink ground, one accent, and type
       small enough that a table of thirty rows is still one screen. */
    .adm {
        min-height: 100vh;
        background: var(--dark);
        color: rgba(255, 255, 255, 0.86);
        font-family: var(--sans);
        padding: clamp(24px, 4vw, 56px);
    }

    .adm [hidden] {
        display: none !important;
    }

    /* --- sign in --- */

    .adm-login {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .adm-login-form {
        width: min(360px, 100%);
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .adm-login-title {
        font-family: var(--serif);
        font-weight: 400;
        font-size: 44px;
        line-height: 1;
        color: #fff;
        margin-bottom: 8px;
    }

    .adm-login-step {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }

    .adm-login-step[hidden] {
        display: none;
    }

    .adm-login-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .adm-login-hint {
        font-size: 13px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.45);
    }

    /* A quiet way out of the second step — it should not compete with the
       code field for attention. */
    .adm-login-back {
        align-self: flex-start;
        border-color: transparent !important;
        padding-left: 0 !important;
        color: rgba(255, 255, 255, 0.4) !important;
    }

    .adm-login-back:hover {
        background: transparent !important;
        color: #fff !important;
    }

    /* The code is read six characters at a time; give it the room. */
    .adm input[name="code"] {
        letter-spacing: 0.4em;
        font-size: 20px;
    }

    .adm-login-field .label {
        color: rgba(255, 255, 255, 0.45);
    }

    /* Every input, not a list of types. The first version of this named
       `password` and `date`, which quietly left the email and the code fields
       as white browser-default boxes on an ink page the moment the form grew
       a second step. A rule about "text fields on this page" should say that. */
    .adm input {
        appearance: none;
        background: transparent;
        border: 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.25);
        color: #fff;
        font-family: var(--sans);
        /* 16px is the floor that stops iOS zooming the page on focus. */
        font-size: 16px;
        padding: 10px 0;
        outline: none;
        border-radius: 0;
        transition: border-color 0.25s var(--ease);
    }

    .adm input::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }

    .adm input:focus {
        border-bottom-color: var(--accent);
    }

    /* A password manager filling the form would otherwise paint Chrome's own
       pale background straight across a dark field — and `background` cannot
       override it. The inset shadow is the only thing that reaches, and the
       text colour needs saying separately. */
    .adm input:-webkit-autofill,
    .adm input:-webkit-autofill:hover,
    .adm input:-webkit-autofill:focus {
        -webkit-text-fill-color: #fff;
        -webkit-box-shadow: 0 0 0 1000px var(--dark) inset;
        caret-color: #fff;
        transition: background-color 100000s ease 0s;
    }

    .adm button {
        appearance: none;
        cursor: pointer;
        font-family: var(--sans);
        font-size: 11px;
        letter-spacing: 0.16em;
        border: 1px solid rgba(255, 255, 255, 0.28);
        background: transparent;
        color: #fff;
        padding: 11px 18px;
        transition:
            background 0.25s var(--ease),
            border-color 0.25s var(--ease),
            color 0.25s var(--ease);
    }

    .adm button:hover,
    .adm button:focus-visible {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.55);
    }

    .adm-login-error:empty {
        display: none;
    }

    .adm-login-error {
        font-size: 13px;
        color: oklch(0.72 0.15 30);
    }

    /* --- shell --- */

    .adm-head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        padding-bottom: 24px;
        border-bottom: 1px solid var(--rule-dark);
        margin-bottom: 32px;
    }

    .adm-title {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(34px, 5vw, 52px);
        line-height: 1;
        color: #fff;
    }

    .adm-subtitle {
        margin-top: 10px;
        color: rgba(255, 255, 255, 0.45);
    }

    .adm-controls {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
    }

    .adm-ranges {
        display: flex;
    }

    .adm-ranges button {
        border-right-width: 0;
    }

    .adm-ranges button:last-child {
        border-right-width: 1px;
    }

    .adm-ranges button[aria-pressed="true"] {
        background: var(--accent);
        border-color: var(--accent);
        color: var(--ink);
    }

    .adm-error {
        margin-bottom: 24px;
        padding: 14px 18px;
        border: 1px solid oklch(0.72 0.15 30 / 0.5);
        color: oklch(0.78 0.13 30);
        font-size: 13px;
    }

    /* --- tiles --- */

    .adm-tiles {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 1px;
        background: var(--rule-dark);
        border: 1px solid var(--rule-dark);
        margin-bottom: 32px;
    }

    .adm-tile {
        background: var(--dark);
        padding: 20px;
    }

    .adm-tile-label {
        color: rgba(255, 255, 255, 0.45);
    }

    .adm-tile-value {
        font-family: var(--serif);
        font-size: 38px;
        line-height: 1.1;
        color: #fff;
        margin: 12px 0 10px;
        font-variant-numeric: tabular-nums;
    }

    .adm-tile-foot {
        display: flex;
        align-items: baseline;
        gap: 8px;
        font-size: 11px;
    }

    .adm-tile-hint {
        color: rgba(255, 255, 255, 0.3);
    }

    .adm-delta {
        font-variant-numeric: tabular-nums;
        color: rgba(255, 255, 255, 0.45);
    }

    .adm-delta[data-dir="up"] {
        color: oklch(0.8 0.15 150);
    }

    .adm-delta[data-dir="down"] {
        color: oklch(0.72 0.15 30);
    }

    /* --- panels --- */

    .adm-panel {
        border: 1px solid var(--rule-dark);
        padding: 22px;
        margin-bottom: 22px;
    }

    .adm-panel-head {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 20px;
    }

    .adm-panel-head h2 {
        font-family: var(--serif);
        font-weight: 400;
        font-size: 20px;
        color: #fff;
    }

    .adm-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
    }

    .adm-columns-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .adm-columns > .adm-panel {
        margin-bottom: 22px;
    }

    .adm-legend {
        display: flex;
        gap: 14px;
        font-size: 10px;
        letter-spacing: 0.18em;
        color: rgba(255, 255, 255, 0.45);
    }

    .adm-key::before {
        content: "";
        display: inline-block;
        width: 10px;
        height: 2px;
        margin-right: 6px;
        vertical-align: middle;
    }

    .adm-key-sessions::before {
        background: var(--accent);
    }

    .adm-key-visitors::before {
        background: rgba(255, 255, 255, 0.4);
    }

    /* --- charts --- */

    .adm-chart svg {
        width: 100%;
        height: 260px;
        overflow: visible;
    }

    .adm-chart-short svg {
        height: 150px;
    }

    .adm-chart .grid {
        stroke: rgba(255, 255, 255, 0.1);
        stroke-width: 1;
    }

    .adm-chart .axis {
        fill: rgba(255, 255, 255, 0.4);
        font-size: 9px;
        font-family: var(--sans);
        letter-spacing: 0.1em;
    }

    .adm-chart .line-sessions {
        fill: none;
        stroke: var(--accent);
        stroke-width: 1.5;
    }

    .adm-chart .line-visitors {
        fill: none;
        stroke: rgba(255, 255, 255, 0.4);
        stroke-width: 1;
        stroke-dasharray: 3 3;
    }

    .adm-chart .area {
        fill: var(--accent);
        opacity: 0.12;
    }

    .adm-chart .bar {
        fill: var(--accent);
        opacity: 0.75;
    }

    /* --- horizontal bar lists --- */

    .adm-bars {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .adm-bar-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 10px 14px;
        align-items: center;
        font-size: 13px;
    }

    .adm-bar-label {
        color: rgba(255, 255, 255, 0.7);
    }

    .adm-bar-value {
        font-variant-numeric: tabular-nums;
        color: #fff;
    }

    .adm-bar-track {
        grid-column: 1 / -1;
        height: 6px;
        background: rgba(255, 255, 255, 0.1);
    }

    .adm-bar-fill {
        display: block;
        height: 100%;
        background: var(--accent);
    }

    /* --- tables --- */

    .adm-table {
        font-size: 13px;
    }

    .adm-table table {
        width: 100%;
        border-collapse: collapse;
    }

    .adm-table th {
        text-align: left;
        font-weight: 500;
        font-size: 9px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(255, 255, 255, 0.4);
        padding-bottom: 10px;
        border-bottom: 1px solid var(--rule-dark);
    }

    .adm-table td {
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.07);
        color: rgba(255, 255, 255, 0.75);
    }

    .adm-table td.num,
    .adm-table th.num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        padding-left: 12px;
    }

    /* The proportion, drawn behind the row instead of in a column of its own. */
    .adm-table td.lead {
        position: relative;
        padding-left: 10px;
    }

    .adm-table td.lead::before {
        content: "";
        position: absolute;
        left: 0;
        top: 4px;
        bottom: 4px;
        width: var(--share, 0%);
        background: rgba(217, 211, 198, 0.14);
    }

    /* Eight columns will not fit a phone, and squashing them turns every cell
       into two wrapped words. Give the table a floor and let the panel scroll
       sideways instead. */
    .adm-table-wide {
        overflow-x: auto;
    }

    .adm-table-wide table {
        min-width: 720px;
    }

    .adm-empty {
        color: rgba(255, 255, 255, 0.35);
        font-size: 13px;
        padding: 8px 0;
    }

    @media (max-width: 1100px) {
        .adm-columns-3 {
            grid-template-columns: 1fr 1fr;
        }
    }

    @media (max-width: 760px) {
        .adm-columns,
        .adm-columns-3 {
            grid-template-columns: 1fr;
        }

        .adm-head {
            align-items: flex-start;
        }

        /* Eight headline numbers stacked one per screen is four screens of
           scrolling before the first chart. Two up. */
        .adm-tiles {
            grid-template-columns: 1fr 1fr;
        }

        .adm-tile {
            padding: 16px;
        }

        .adm-tile-value {
            font-size: 30px;
        }
    }
</style>
