---
// The HTML shell: head, fonts, favicons. Everything below it is static
// markup plus a handful of plain ES modules — there is no framework
// runtime on this page.
import "../styles/fonts.css";
import "../styles/base.css";
import "../styles/cursor.css";
import { owner } from "../data/site.ts";
import { alternates, defaultLocale, getContent, pathFor, toLocale } from "../i18n/index.ts";

const locale = toLocale(Astro.currentLocale);
const t = getContent(locale);
const who = { ...owner, role: t.owner.role, city: t.owner.city };

interface Props {
    title?: string;
    description?: string;
    /**
     * A plain document page — `/privacy`, `/admin`. They share the shell and
     * the tokens and nothing else: no splash to lift, no timeline to reveal
     * anything, and no custom cursor, which matters because `html.motion`
     * hides the system one (cursor.css) on the assumption that something is
     * drawing a replacement.
     */
    bare?: boolean;
    /** Keeps the page out of search results. */
    noindex?: boolean;
    /**
     * Overrides the link-preview image, as a path relative to the site root.
     * Project pages hand over their own artwork; everything else shows the
     * card in `public/og-card.png`.
     */
    image?: string;
    /**
     * `website` for the portfolio, `article` for a project page. It is the
     * one og: field that is wrong by default on a multi-page site.
     */
    ogType?: "website" | "article";
}

const {
    // `t.owner.role` rather than the words again: this is the fourth place the
    // job title is read, and the only reason they have never disagreed is
    // that none of them spells it out.
    title = `${owner.name} — ${t.owner.role}`,
    description = t.meta.description(who),
    bare = false,
    noindex = false,
    image = "/og-card.png",
    ogType = "website",
} = Astro.props;

// Written into the head as a string rather than as JSX so the braces below
// stay JavaScript — the same reason the dev blocks further down use set:html.
const BOOT_JS = `
(function () {
    var d = document.documentElement;
    d.classList.add("js");
    ${bare ? "" : `if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        // \`splash-open\` is dropped by lib/splash.ts once the panel has
        // irised away; it keeps the custom cursor off the intro, which is
        // its own scene. It also locks scrolling, so a page with no splash
        // must never set it.
        d.classList.add("motion", "splash-open");
    }`}
})();
`;

const origin = Astro.site ?? new URL("https://frascella.dev");

// Self-referential, and per locale: `/it/privacy/` is its own canonical, not a
// variant of the English one. Built from `pathFor` rather than from the raw
// pathname so it carries the same trailing slash the sitemap and the links do.
const canonical = new URL(pathFor(locale, Astro.url.pathname), origin);

/**
 * The `hreflang` set — every language version of this page including itself,
 * plus `x-default` on the one that serves a reader the site has no better
 * answer for.
 *
 * Skipped when `noindex` is set, which today means `/admin`. It has no Italian
 * twin, and an alternate pointing at a page that does not exist is a worse
 * signal than saying nothing. The two flags travel together on purpose: a page
 * worth keeping out of the index is a page not worth cross-linking.
 */
const langLinks = noindex ? [] : alternates(Astro.url.pathname);
const xDefault = langLinks.find((l) => l.locale === defaultLocale);

// og:image has to be absolute. A relative one is legal by the spec and read
// correctly by roughly nobody: most scrapers fetch the URL as given, get a
// 404, and fall back to no preview at all.
const socialImage = new URL(image, canonical);

// The dev toolbar's "skip the splash" switch (src/devtools/settings.ts) writes
// a localStorage flag; this reads it before the first paint and turns it into
// a class, exactly the way `js` and `motion` are set below. Both strings are
// rendered into the head only under `astro dev` — a production build emits
// neither, so there is nothing to strip and nothing to leak.
const DEV_SKIP_SPLASH_JS = `
(function () {
    if (localStorage.getItem("portfolio:dev:skip-splash") !== "1") return;
    var d = document.documentElement;
    d.classList.remove("splash-open");
    d.classList.add("dev-no-splash");
})();
`;

// The panel is only ever painted because a timeline is going to take it away
// again (see Splash.astro). Skipping that timeline means hiding it here, or it
// simply stays up. `!important` because the rule it has to beat —
// `html.motion .splash` — carries the same specificity.
const DEV_SKIP_SPLASH_CSS = `html.dev-no-splash .splash { display: none !important; }`;
---

<!doctype html>
<html lang={t.htmlLang}>
    <head>
        <meta charset="utf-8" />
        {/* No `maximum-scale`, no `user-scalable=no`. They were here to keep
            the composed scene from being pulled apart by a pinch, and that is
            not a trade that is ours to make: refusing zoom fails WCAG 1.4.4,
            and the people it stops are the ones who cannot read the page
            without it. A zoomed viewport looking odd is a worse layout; a
            locked one is an unreadable page. */}
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        {/* One fixed colour, deliberately not media-queried: the browser bars
            stay ink-dark whatever the page behind them is showing. iOS 26
            Safari ignores this and samples the page instead — that side is
            handled by the `.bar-tint` strips and the dark body in base.css. */}
        <meta name="theme-color" content="#0b0b0b" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        {noindex && <meta name="robots" content="noindex, nofollow" />}

        {/* Reciprocal, and including this page itself. Google reads the set as
            a whole: a version missing from its own set invalidates the set,
            and a one-way declaration is discarded silently. */}
        {langLinks.map((l) => (
            <link rel="alternate" hreflang={l.hreflang} href={new URL(l.path, origin)} />
        ))}
        {xDefault && (
            <link rel="alternate" hreflang="x-default" href={new URL(xDefault.path, origin)} />
        )}

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content={ogType} />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content={owner.name} />
        <meta property="og:locale" content={t.ogLocale} />
        {langLinks
            .filter((l) => l.locale !== locale)
            .map((l) => <meta property="og:locale:alternate" content={getContent(l.locale).ogLocale} />)}
        {/* 1200×630 is what every scraper crops to; stating the size lets a
            preview reserve the space before the image has arrived. */}
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={`${owner.name} — ${t.owner.role}`} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={socialImage} />

        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        {/* The typefaces are served from this domain — see styles/fonts.css
            for why. Preloading the two latin subsets because they are the
            only fonts the first screen can possibly need, and discovering
            them through the stylesheet costs a round trip the headline
            spends in a fallback face. */}
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href="/fonts/gloock-latin.woff2"
            crossorigin
        />
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href="/fonts/schibsted-grotesk-latin.woff2"
            crossorigin
        />

        <!-- Blocking on purpose, and tiny. The stylesheet hides the splash,
             the collapsed accordion and the whole work stage unless `motion`
             is set, so this has to land before the first paint or the page
             flashes its static self and then jumps. -->
        <script is:inline set:html={BOOT_JS} />

        {import.meta.env.DEV && <script is:inline set:html={DEV_SKIP_SPLASH_JS} />}
        {import.meta.env.DEV && <style is:inline set:html={DEV_SKIP_SPLASH_CSS} />}
    </head>
    <body>
        <!-- Sampling targets for iOS 26 Safari's bar tinting — see base.css. -->
        <div class="bar-tint bar-tint-top" aria-hidden="true"></div>
        <div class="bar-tint bar-tint-bottom" aria-hidden="true"></div>
        <slot />
    </body>
</html>
