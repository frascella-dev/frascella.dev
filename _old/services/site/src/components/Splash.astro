---
// The intro: the monogram is drafted on a construction grid — guides, then
// node points, then the glyph outline strokes itself and fills — and the
// whole panel then irises shut to reveal the page. The `data-*` hooks are
// read by `lib/splash.ts`.
---

<div data-splash class="splash" data-cursor-scheme="dark">
    <svg data-splash-svg viewBox="0 0 128 128" aria-hidden="true">
        <g data-splash-guides>
            <rect data-g x="21" y="10" width="88.7" height="110" fill="none" stroke="#fff" stroke-opacity=".3" stroke-width=".3"></rect>
            <line data-g x1="21.6" y1="0" x2="21.6" y2="128" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="31.1" y1="0" x2="31.1" y2="128" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="47.4" y1="0" x2="47.4" y2="128" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="57.7" y1="0" x2="57.7" y2="128" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="70.5" y1="0" x2="70.5" y2="128" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="80.9" y1="0" x2="80.9" y2="128" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="96.8" y1="0" x2="96.8" y2="128" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="109.7" y1="0" x2="109.7" y2="128" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="0" y1="10" x2="128" y2="10" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="0" y1="22.9" x2="128" y2="22.9" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="0" y1="47.4" x2="128" y2="47.4" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="0" y1="63.4" x2="128" y2="63.4" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="0" y1="81.4" x2="128" y2="81.4" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="0" y1="106.3" x2="128" y2="106.3" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="0" y1="120" x2="128" y2="120" stroke="#fff" stroke-opacity=".16" stroke-width=".22"></line>
            <line data-g x1="21" y1="10" x2="109.7" y2="120" stroke="#fff" stroke-opacity=".1" stroke-width=".22"></line>
            <line data-g x1="109.7" y1="10" x2="21" y2="120" stroke="#fff" stroke-opacity=".1" stroke-width=".22"></line>
            <circle data-n cx="80.9" cy="22.9" r="1.1" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width=".3"></circle>
            <circle data-n cx="109.7" cy="59.8" r="1.1" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width=".3"></circle>
            <circle data-n cx="109.6" cy="71" r="1.1" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width=".3"></circle>
