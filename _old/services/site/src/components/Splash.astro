            fill="#fff"
            fill-opacity="0"
            stroke="#fff"
            stroke-width=".45"
            stroke-linejoin="round"
            stroke-linecap="round"></path>
    </svg>
</div>

<style is:global>
    /* Only ever painted when something is going to animate it away again.
       Without `motion` — no script, or reduced motion — it never shows. */
    .splash {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 100;
        background: var(--dark);
        align-items: center;
        justify-content: center;
        will-change: clip-path;
    }

    html.motion .splash {
        display: flex;
    }

    .splash svg {
        width: min(46vw, 430px);
        height: auto;
        overflow: visible;
    }

</style>
