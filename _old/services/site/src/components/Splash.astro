            <circle data-n cx="47.4" cy="106.3" r="1.1" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width=".3"></circle>
            <circle data-n cx="96.8" cy="120" r="1.1" fill="none" stroke="#fff" stroke-opacity=".55" stroke-width=".3"></circle>
