#!/usr/bin/env bash
# The two release packages, from the working tree: the theme (built, without its sources)
# and the plugin (without its tests). Versions come from style.css and the plugin header,
# which must agree — one release, one number.
#
#   bin/build-zips            → dist/frascella-theme-<version>.zip, dist/frascella-plugin-<version>.zip
set -euo pipefail
cd "$(dirname "$0")/.."

THEME=wp-content/themes/frascella
PLUGIN=wp-content/plugins/frascella
theme_version=$(sed -n 's/^Version: *//p' "$THEME/style.css" | tr -d '\r')
plugin_version=$(sed -n 's/^ \* Version: *//p' "$PLUGIN/frascella.php" | tr -d '\r')
constant_version=$(sed -n "s/^define('FRASCELLA_VERSION', '\(.*\)');/\1/p" "$PLUGIN/frascella.php")
if [ "$theme_version" != "$plugin_version" ] || [ "$plugin_version" != "$constant_version" ]; then
    echo "Versions disagree: style.css $theme_version, plugin header $plugin_version, FRASCELLA_VERSION $constant_version." >&2
    exit 1
fi

(cd "$THEME" && npm ci --silent && npm run build --silent)
test -f "$THEME/assets/dist/.vite/manifest.json" || { echo "No manifest after the build." >&2; exit 1; }

mkdir -p dist
rm -f "dist/frascella-theme-$theme_version.zip" "dist/frascella-plugin-$plugin_version.zip"
(cd wp-content/themes && zip -qr "../../dist/frascella-theme-$theme_version.zip" frascella \
    -x "frascella/node_modules/*" "frascella/assets/src/*" "frascella/package.json" "frascella/package-lock.json" \
       "frascella/vite.config.mjs" "frascella/tsconfig.json" "frascella/.gitignore" "*.DS_Store")
(cd wp-content/plugins && zip -qr "../../dist/frascella-plugin-$plugin_version.zip" frascella \
    -x "frascella/node_modules/*" "frascella/tests/*" "frascella/package.json" "frascella/package-lock.json" "frascella/.gitignore" "*.DS_Store")
ls -la dist/*"$theme_version".zip
