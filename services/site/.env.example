# Base URL of the PHP API — the contact form, the analytics beacon and the
# dashboard all go through it. Empty means same-origin, which is what the
# deploy build (services/builder) uses.
#
# Cross-origin in dev means cookies: the API only grants credentials to an
# origin named explicitly in its CORS_ORIGINS, so keep the two in step.
#
# Astro exposes PUBLIC_-prefixed vars to the client; VITE_API_URL still works.
PUBLIC_API_URL=http://localhost:3000
