---
// The HTML shell: head, fonts, favicons. Everything below it is static
// markup plus a handful of plain ES modules — there is no framework
// runtime on this page.
import "../styles/base.css";
import "../styles/cursor.css";
import { owner } from "../data/site.ts";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = `${owner.name} — ${owner.role}`,
    description = `Portfolio of ${owner.name}, a software engineer born in ${owner.city}. Backend and the game engines behind online casino platforms — before that, telemedicine and solar panel design.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://frascella.dev");

// The dev toolbar's "skip the splash" switch (src/devtools/settings.ts) writes
// a localStorage flag; this reads it before the first paint and turns it into
// a class, exactly the way `js` and `motion` are set below. Both strings are
// rendered into the head only under `astro dev` — a production build emits
// neither, so there is nothing to strip and nothing to leak.
const DEV_SKIP_SPLASH_JS = `
(function () {
    if (localStorage.getItem("portfolio:dev:skip-splash") !== "1") return;
    var d = document.documentElement;
    d.classList.remove("splash-open");
    d.classList.add("dev-no-splash");
})();
`;

// The panel is only ever painted because a timeline is going to take it away
// again (see Splash.astro). Skipping that timeline means hiding it here, or it
// simply stays up. `!important` because the rule it has to beat —
// `html.motion .splash` — carries the same specificity.
const DEV_SKIP_SPLASH_CSS = `html.dev-no-splash .splash { display: none !important; }`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"
        />

        {/* One fixed colour, deliberately not media-queried: the browser bars
            stay ink-dark whatever the page behind them is showing. iOS 26
            Safari ignores this and samples the page instead — that side is
            handled by the `.bar-tint` strips and the dark body in base.css. */}
        <meta name="theme-color" content="#0b0b0b" />

        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:image" content="/apple-touch-icon.png" />
        <meta name="twitter:card" content="summary" />

        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Gloock&family=Schibsted+Grotesk:wght@400;500;600&display=swap"
            rel="stylesheet"
        />

        <!-- Blocking on purpose, and tiny. The stylesheet hides the splash,
             the collapsed accordion and the whole work stage unless `motion`
             is set, so this has to land before the first paint or the page
             flashes its static self and then jumps. -->
        <script is:inline>
            (function () {
                var d = document.documentElement;
                d.classList.add("js");
                // iOS Safari ignores `user-scalable=no`; refusing its
                // proprietary gesture events is what actually stops the pinch.
                document.addEventListener("gesturestart", function (e) {
                    e.preventDefault();
                });
                if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
                    // `splash-open` is dropped by lib/splash.ts once the panel
                    // has irised away; it keeps the custom cursor off the
                    // intro, which is its own scene.
                    d.classList.add("motion", "splash-open");
                }
            })();
        </script>

        {import.meta.env.DEV && <script is:inline set:html={DEV_SKIP_SPLASH_JS} />}
        {import.meta.env.DEV && <style is:inline set:html={DEV_SKIP_SPLASH_CSS} />}
    </head>
    <body>
        <!-- Sampling targets for iOS 26 Safari's bar tinting — see base.css. -->
        <div class="bar-tint bar-tint-top" aria-hidden="true"></div>
        <div class="bar-tint bar-tint-bottom" aria-hidden="true"></div>
        <slot />
    </body>
</html>
