---
// The portfolio, in whichever language the route asked for.
//
// `src/pages/index.astro` and `src/pages/it/index.astro` are three lines each
// and both render this. Nothing below is duplicated per language — not the
// composition, not the structured data, not the stylesheet — and every
// component under it reads `Astro.currentLocale` for itself.
import Base from "./Base.astro";
import Splash from "../components/Splash.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Bio from "../components/Bio.astro";
import Work from "../components/Work.astro";
import Contact from "../components/Contact.astro";
import Consent from "../components/Consent.astro";
import { owner } from "../data/site.ts";
import { getContent, locales, pathFor, toLocale } from "../i18n/index.ts";

const locale = toLocale(Astro.currentLocale);
const t = getContent(locale);

// One page, one graph: the person, the site, this page, and the work.
//
// The work half is here because it has nowhere else to be. The corridor
// paints its slab labels into a canvas and keeps its captions in an overlay
// that is `visibility: hidden` at rest, so a renderer finds no projects on
// this page (see Work.astro). This is the opposite of hiding text from a
// reader to show it to a crawler: the projects are on the page, a scrolling
// human reads every word of them, and JSON-LD is the channel meant for
// exactly that gap — content that is genuinely present but not in a form a
// parser can take. Nothing below says anything the visitor is not shown.
//
// Every value is read from the content tree. Adding a project adds it to the
// graph, in both languages.
const origin = Astro.site ?? new URL("https://frascella.dev");
const root = new URL("/", origin).href;
const here = new URL(pathFor(locale, Astro.url.pathname), origin).href;

// The person and the site keep **one** `@id` across both languages: there is
// one Emanuele and one frascella.dev, and minting a second of each per locale
// would describe two people who happen to share a name. The page is per URL,
// because /it/ genuinely is a different page.
const personId = `${root}#me`;
const siteId = `${root}#site`;

/**
 * `meta` reads "2026 · flutter · python · mysql" — the year and the stack on
 * one line, because that is how it sits under the caption. Split rather than
 * stored twice, so the line and the graph cannot drift.
 */
function splitMeta(meta: string) {
    const parts = meta.split("·").map((part) => part.trim()).filter(Boolean);
    const year = /^\d{4}$/.test(parts[0]) ? parts.shift() : undefined;
    return { year, stack: parts };
}

const graph = [
    {
        "@type": "Person",
        "@id": personId,
        name: owner.name,
        url: root,
        jobTitle: t.owner.role,
        address: { "@type": "PostalAddress", addressLocality: "Taranto", addressCountry: "IT" },
        sameAs: [owner.github, owner.linkedin],
        knowsAbout: ["JavaScript", "PHP", "Python", "Node.js", "MySQL", "Redis", "Docker", "AWS"],
    },
    {
        "@type": "WebSite",
        "@id": siteId,
        url: root,
        name: `${owner.name} — ${t.owner.role}`,
        inLanguage: locales.map((l) => getContent(l).htmlLang),
        publisher: { "@id": personId },
    },
    {
        // The page is about its owner, which is what a portfolio homepage is.
        "@type": "ProfilePage",
        "@id": `${here}#page`,
        url: here,
        inLanguage: t.htmlLang,
        isPartOf: { "@id": siteId },
        mainEntity: { "@id": personId },
        hasPart: { "@id": `${here}#work` },
    },
    {
        "@type": "ItemList",
        "@id": `${here}#work`,
        name: t.work.eyebrow,
        numberOfItems: t.work.projects.length,
        // Corridor order, which is the order they are walked past.
        itemListOrder: "https://schema.org/ItemListOrderAscending",
        itemListElement: t.work.projects.map((project, i) => {
            const { year, stack } = splitMeta(project.meta);
            return {
                "@type": "ListItem",
                position: i + 1,
                item: {
                    // Not SoftwareApplication: that type's rich result wants a
                    // price or a rating, and neither of these has one to give.
                    "@type": "CreativeWork",
                    // Shared across locales, keyed on the untranslated name —
                    // vitrine is one project, described twice. Which is why
                    // the description below is language-tagged: two plain
                    // strings on one `@id` would read as a contradiction,
                    // while `@language` states plainly that they are the same
                    // sentence in two languages.
                    "@id": `${root}#work-${project.title}`,
                    name: project.title,
                    description: { "@value": project.desc, "@language": t.htmlLang },
                    author: { "@id": personId },
                    ...(year ? { dateCreated: year } : {}),
                    keywords: stack.join(", "),
                },
            };
        }),
    },
];

// `set:html` puts this into the document verbatim, and JSON.stringify leaves
// `<` alone — a description containing `</script>` would end the block early.
// None does today; escaping it means none ever can.
const schema = JSON.stringify({ "@context": "https://schema.org", "@graph": graph }).replaceAll("<", "\\u003c");
---

<Base>
    <!-- The paper the whole page sits on: a fluid sim tinted like ink, or —
         where that costs more than it shows — a still sheet with the same
         tint settled into it. Exactly one of the two ever paints. -->
    <canvas data-fluid class="fluid" aria-hidden="true"></canvas>
    <div class="paper" aria-hidden="true"></div>

    <!-- Replaces the system pointer; CSS keeps both out of the way where
         there is no pointer to replace. -->
    <div data-cursor-dot class="cursor-dot" aria-hidden="true"></div>
    <div data-cursor-ring class="cursor-ring" aria-hidden="true">
        <span data-cursor-ring-label class="cursor-label"></span>
    </div>

    <Splash />
    <Nav />

    <main>
        <Hero />
        <Bio />
        <Work />
        <Contact />
    </main>

    <Consent />

    <script type="application/ld+json" set:html={schema} is:inline />
    <script>
        import "../lib/main.ts";
    </script>
</Base>

<style is:global>
    .fluid,
    .paper {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        z-index: 0;
        pointer-events: none;
    }

    /* Nothing to simulate unless the motion layer is running. */
    .fluid {
        display: none;
    }

    html.motion .fluid {
        display: block;
    }

    /* The still sheet: the fluid's ink tint, pooled where the simulation
       tends to leave it. Three gradients, no frames, no battery. */
    .paper {
        display: none;
        background:
            radial-gradient(78% 52% at 12% 4%, rgba(217, 211, 198, 0.3), transparent 62%),
            radial-gradient(64% 46% at 92% 34%, rgba(217, 211, 198, 0.24), transparent 66%),
            radial-gradient(88% 40% at 44% 104%, rgba(217, 211, 198, 0.2), transparent 70%);
    }

    /* Where the solver is skipped — see `isLite` in lib/env.ts, which reads
       the same conditions — or where there is no script at all. */
    @media (max-width: 900px), (pointer: coarse) {
        html.motion .fluid {
            display: none;
        }

        .paper {
            display: block;
        }
    }

    html:not(.motion) .paper {
        display: block;
    }
</style>
