---
// The consent bar. Rendered into the static HTML but `hidden` until
// `lib/consent.ts` decides it is needed — a returning visitor who already
// answered never sees it flash.
//
// Three things about the shape of it are deliberate. The buttons are the same
// size, the same weight and the same colour, because a bright "accept" beside
// a greyed-out "decline" is the exact pattern the Garante's June 2021
// guidelines call out. "decline" comes first, so the way out is the thing the
// eye lands on rather than the thing it has to hunt for. And it sits inset
// from the bottom edge rather than flush against it, so it stays clear of the
// strip iOS 26 samples to tint its bars (see base.css) — a full-width panel on
// the edge would repaint the browser chrome.
//
// The copy is the standard three moves — whose cookies, what for, where the
// detail is — and it stops there. It was longer once, and the length was the
// problem: a banner nobody finishes reading is not more informative than a
// short one, and the argument for asking rests on /privacy, which says all of
// it properly. Both claims made here are load-bearing and both are true of
// the code: the cookies are this site's own, and nothing goes anywhere else.
//
// The first sentence is a question, not a statement, on purpose. The
// Garante's June 2021 guidelines require the short banner to say the site
// *may*, subject to consent, use these cookies — not that it already does —
// and a question makes that conditional the reader's own choice rather than
// something to infer from the buttons below.
import { getContent, pathFor, toLocale } from "../i18n/index.ts";

const locale = toLocale(Astro.currentLocale);
const t = getContent(locale);
---

<aside data-consent class="consent" hidden aria-label={t.consent.label}>
    <p class="consent-copy">
        {t.consent.copyBefore}{" "}
        <a href={pathFor(locale, "/privacy")}>{t.consent.privacyLink}</a>{t.consent.copyAfter}
    </p>

    <div class="consent-actions">
        <button data-consent-deny type="button">{t.consent.decline}</button>
        <button data-consent-accept type="button">{t.consent.accept}</button>
    </div>
</aside>

<style is:global>
    .consent {
        position: fixed;
        left: 12px;
        right: 12px;
        bottom: 12px;
        z-index: 80;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: clamp(16px, 3vw, 40px);
        padding: 18px clamp(18px, 2.4vw, 28px);
        border: 1px solid rgba(255, 255, 255, 0.16);
        background: rgba(11, 11, 11, 0.94);
        backdrop-filter: blur(10px);
        color: rgba(255, 255, 255, 0.72);
        font-family: var(--sans);
        font-size: 13px;
        line-height: 1.5;
    }

    .consent[hidden] {
        display: none;
    }

    /* Arrives with the page settled, not on top of the splash. */
    html.motion .consent {
        opacity: 0;
        transform: translateY(8px);
        transition:
            opacity 0.5s var(--ease),
            transform 0.5s var(--ease);
    }

    html.motion .consent.is-in {
        opacity: 1;
        transform: none;
    }

    .consent-copy {
        margin: 0;
        max-width: 78ch;
    }

    .consent-copy a {
        color: #fff;
        text-underline-offset: 3px;
    }

    .consent-actions {
        display: flex;
        gap: 10px;
        flex: none;
    }

    /* Same size, same weight, same colour — the choice is not being nudged. */
    .consent-actions button {
        appearance: none;
        border: 1px solid rgba(255, 255, 255, 0.3);
        background: transparent;
        color: #fff;
        font-family: var(--sans);
        font-size: 12px;
        letter-spacing: 0.14em;
        text-transform: lowercase;
        padding: 10px 20px;
        cursor: pointer;
        transition:
            background 0.25s var(--ease),
            border-color 0.25s var(--ease);
    }

    .consent-actions button:hover,
    .consent-actions button:focus-visible {
        background: rgba(255, 255, 255, 0.1);
        border-color: rgba(255, 255, 255, 0.55);
    }

    @media (max-width: 900px) {
        .consent {
            flex-direction: column;
            align-items: stretch;
            gap: 16px;
            font-size: 12.5px;
        }

        .consent-actions button {
            flex: 1;
        }
    }
</style>
