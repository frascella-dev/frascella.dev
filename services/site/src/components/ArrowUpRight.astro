---
// The "opens elsewhere" mark. Drawn rather than typed: U+2197 ↗ has an emoji
// presentation in the Apple fonts, so on iOS the character turns into a
// full-colour emoji in the middle of a hairline pill. This is the same
// geometry the rest of the page uses — a diagonal and a corner, flat caps,
// scaled to the text it sits next to and inheriting its colour.
interface Props {
    class?: string;
}
const { class: className } = Astro.props;
---

<svg
    class:list={["arrow-ne", className]}
    viewBox="0 0 12 12"
    aria-hidden="true"
    focusable="false"
>
    <path
        d="M3.2 8.8 8.8 3.2M4.6 3.2h4.2v4.2"
        fill="none"
        stroke="currentColor"
        stroke-width="1.3"
    ></path>
</svg>

<style is:global>
    .arrow-ne {
        width: 0.78em;
        height: 0.78em;
        flex: none;
        /* The cap height of the label, not its line box — otherwise it floats
           above the letters in the pills. */
        margin-top: -0.08em;
    }
</style>
