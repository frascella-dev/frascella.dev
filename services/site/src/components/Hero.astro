---
// The opening frame. Portrait pinned bottom-right against a hairline rule,
// headline and chips on the left. `data-speed` marks the two elements the
// scroll layer parallaxes; the title is word-split and staggered in on load.
import { Picture } from "astro:assets";
import portrait from "../assets/portrait.webp";
import { owner, heroChips } from "../data/site.ts";
---

<section id="top" class="hero">
    {/* AVIF first, WebP for everything that can't take it. The source is a
        3680px master; nothing wider than 1600 is ever served. */}
    <Picture
        class="hero-portrait"
        pictureAttributes={{ class: "hero-portrait-frame" }}
        data-speed="1.14"
        src={portrait}
        alt={`Portrait of ${owner.name}`}
        formats={["avif", "webp"]}
        fallbackFormat="webp"
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 900px) 100vw, 33vw"
        loading="eager"
        fetchpriority="high"
    />
    <div class="hero-rule" data-speed="0.86"></div>

    <div class="hero-copy">
        <h1 data-hero-title class="hero-title">
            {/* Read, not typed — the same field as the <title>, the JSON-LD
                and the footer. Lowercased because here it opens a sentence
                that is set in lower case, not because it is a different name
                for the job. */}
            {owner.role.toLowerCase()} <span class="dim">who takes things apart</span> for a living.
        </h1>

        <div class="hero-copy-foot">
            <p class="hero-lede">
                Solar panel design, then telemedicine, then — since February — the game engines
                behind online casino platforms. Three industries, one constant: don't let the
                system fail.
            </p>
            <ul data-hero-chips class="hero-chips">
                {heroChips.map((chip) => <li>{chip}</li>)}
            </ul>
        </div>
    </div>

    <div class="hero-coords" aria-hidden="true">
        <span>{owner.coords}</span>
        <span class="hero-scanline"></span>
    </div>
</section>

<style is:global>
    .hero {
        position: relative;
        height: min(63.34vw, 100vh);
        min-height: 560px;
        overflow: hidden;
        background: transparent;
    }

    .hero-portrait {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 32.5vw;
        height: 43.34vw;
        object-fit: cover;
        object-position: 50% 26%;
        z-index: 2;
    }

    .hero-rule {
        position: absolute;
        right: 32.5vw;
        bottom: 0;
        width: 1px;
        height: 43.34vw;
        background: var(--rule);
    }

    .hero-copy {
        position: absolute;
        left: 3.84vw;
        top: min(10.6vw, 17vh);
        bottom: min(4.5vw, 7vh);
        width: 55vw;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: min(2vw, 3vh);
        z-index: 4;
    }

    .hero-title {
        font-family: var(--serif);
        font-weight: 400;
        font-size: min(6.4vw, 10.4vh);
        line-height: 1.05;
        color: var(--ink);
        text-wrap: pretty;
    }

    .hero-title .dim {
        opacity: 0.34;
    }

    .hero-copy-foot {
        display: flex;
        flex-direction: column;
        gap: 2vw;
    }

    .hero-lede {
        width: min(36vw, 520px);
        font-size: max(13px, min(1.2vw, 2.2vh));
        line-height: 1.7;
        color: var(--ink-soft);
        text-wrap: pretty;
    }

    .hero-chips {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: min(0.84vw, 1.4vh);
    }

    .hero-chips li {
        font-weight: 500;
        font-size: max(9px, min(0.84vw, 1.5vh));
        letter-spacing: 0.14em;
        border: 1px solid rgba(20, 20, 20, 0.16);
        border-radius: 999px;
        padding: min(0.6vw, 1vh) min(1.1vw, 1.9vh);
        color: var(--ink);
    }

    .hero-coords {
        position: absolute;
        left: 1.6vw;
        bottom: 4.5vw;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        z-index: 4;
    }

    .hero-coords > span:first-child {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        font-weight: 500;
        font-size: max(9px, 0.8vw);
        letter-spacing: 0.2em;
        color: rgba(20, 20, 20, 0.5);
        white-space: nowrap;
    }

    .hero-scanline {
        position: relative;
        width: 1px;
        height: 60px;
        background: rgba(20, 20, 20, 0.14);
        overflow: hidden;
    }

    .hero-scanline::after {
        content: "";
        position: absolute;
        inset: 0;
        background: var(--ink);
        animation: efline 1.9s cubic-bezier(0.7, 0, 0.3, 1) infinite;
    }

    /* Narrow, the vw grid stops meaning anything and the two halves stack:
       the type reads first at full width, then the portrait as a real image
       rather than the 18%-opacity ghost it used to be behind the text. */
    @media (max-width: 900px) {
        .hero {
            height: auto;
            min-height: 0;
            overflow: visible;
            /* 104px clears the fixed header at its old, unpadded height;
               growing it by the same top inset the header now carries keeps
               the gap between the two exactly what it always was. */
            padding: 104px 0 0;
            display: flex;
            flex-direction: column;
            gap: 5vh;
        }

        .hero-copy {
            position: static;
            order: 1;
            width: 100%;
            padding: 0 var(--gutter);
            gap: 6vh;
        }

        .hero-title {
            font-size: clamp(34px, 9.4vw, 62px);
        }

        .hero-lede {
            width: 100%;
            max-width: 40ch;
            font-size: 15px;
        }

        .hero-chips {
            gap: 8px;
        }

        .hero-chips li {
            font-size: 10px;
            padding: 8px 14px;
        }

        /* Stacked, the portrait can't be translated the way it is on desktop
           — it sits in normal flow and moving it would just tear a gap under
           it. So the frame is the fixed thing and the image is oversized
           inside it, free to drift within a window that never moves. */
        .hero-portrait-frame {
            display: block;
            order: 2;
            position: relative;
            overflow: hidden;
            height: 96vw;
            max-height: 62svh;
        }

        .hero-portrait {
            position: absolute;
            left: 0;
            /* 24% taller than the window, centred — which leaves 12% of
               travel at each end for the scroll to spend. */
            top: -12%;
            width: 100%;
            height: 124%;
            opacity: 1;
            object-position: 50% 26%;
            will-change: transform;
        }

        .hero-rule {
            display: none;
        }

        /* Out of its vertical rail and onto the baseline under the image,
           where there is room for it to be read left to right. */
        .hero-coords {
            order: 3;
            position: static;
            flex-direction: row;
            align-items: center;
            gap: 12px;
            padding: 0 var(--gutter);
        }

        .hero-coords > span:first-child {
            writing-mode: horizontal-tb;
            transform: none;
            font-size: 9px;
        }

        .hero-scanline {
            width: 40px;
            height: 1px;
        }

        .hero-scanline::after {
            animation-name: efline-x;
        }
    }
</style>
