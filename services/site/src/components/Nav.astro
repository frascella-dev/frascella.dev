---
// Fixed header. `mix-blend-mode: difference` is what lets one white bar sit
// legibly over both the paper hero and the near-black work corridor without
// ever swapping colours — which is also why the menu button lives inside it
// and the drawer does not.
//
// Wide: the four labels sit inline, each with a duplicate that rolls up from
// below on hover (wired in `lib/scroll.ts`).
// Narrow: two lines that cross into an X, and a sheet that comes up from the
// bottom edge (wired in `lib/nav.ts`).
import { owner, navLinks } from "../data/site.ts";
import ArrowUpRight from "./ArrowUpRight.astro";
import Mark from "./Mark.astro";
---

<header class="nav">
    <a class="nav-mark" href="#top" aria-label={`${owner.name} — back to top`}>
        <Mark />
    </a>

    <nav class="nav-links" aria-label="Sections">
        {
            navLinks.map((link) => (
                <a data-navlink href={link.href}>
                    <span data-nav-a>{link.label}</span>
                    <span data-nav-b aria-hidden="true">
                        {link.label}
                    </span>
                </a>
            ))
        }
    </nav>

    <button
        data-nav-toggle
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Open menu"
    >
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
    </button>
</header>

<!-- Not a <dialog>: a modal dialog goes into the top layer, which would put
     it over the header and leave the close control blurred and inert. This
     sits *under* the header instead, so the same two lines that opened it
     cross into an X and close it again. What <dialog> would have given for
     free is done by hand below — `inert` on the page, Escape, focus. -->
<div
    data-nav-drawer
    id="nav-drawer"
    class="nav-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
>
    <nav class="nav-menu" aria-label="Sections">
        {
            navLinks.map((link, i) => (
                <a href={link.href} style={`--i:${i}`}>
                    <span class="label nav-menu-index">{String(i + 1).padStart(2, "0")}</span>
                    <span>{link.label}</span>
                </a>
            ))
        }
    </nav>

    <div class="nav-menu-foot">
        <a class="pill" href={owner.github} target="_blank" rel="noopener">github <ArrowUpRight /></a>
        <a class="pill" href={owner.linkedin} target="_blank" rel="noopener">linkedin <ArrowUpRight /></a>
    </div>
</div>

<style is:global>
    .nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 76px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 var(--gutter);
        z-index: 60;
        mix-blend-mode: difference;
    }

    .nav-mark {
        display: flex;
        align-items: center;
    }

    .nav-mark svg {
        width: clamp(24px, 1.9vw, 29px);
        height: clamp(24px, 1.9vw, 29px);
        fill: #fff;
    }

    .nav-links {
        display: flex;
        gap: clamp(16px, 1.9vw, 28px);
        font-weight: 500;
        font-size: clamp(14px, 1.1vw, 16px);
        color: #fff;
    }

    .nav-links a {
        position: relative;
        display: block;
        overflow: hidden;
        height: 1.3em;
        color: #fff;
    }

    .nav-links a:hover {
        color: #fff;
    }

    .nav-links [data-nav-a] {
        display: block;
        line-height: 1.3em;
    }

    .nav-links [data-nav-b] {
        position: absolute;
        left: 0;
        top: 0;
        display: block;
        line-height: 1.3em;
        visibility: hidden;
    }

    /* --- the button --- */

    .nav-toggle {
        display: none;
        width: 44px;
        height: 44px;
        margin-right: -10px;
        padding: 0;
        border: 0;
        background: none;
        position: relative;
    }

    .nav-toggle span {
        position: absolute;
        left: 11px;
        width: 22px;
        height: 1.5px;
        background: #fff;
        transition:
            transform 0.42s var(--ease),
            opacity 0.2s linear;
    }

    .nav-toggle span:first-child {
        top: 19px;
    }

    .nav-toggle span:last-child {
        top: 25px;
    }

    /* Open, the two lines meet in the middle and cross. */
    .nav-toggle[aria-expanded="true"] span:first-child {
        transform: translateY(3px) rotate(45deg);
    }

    .nav-toggle[aria-expanded="true"] span:last-child {
        transform: translateY(-3px) rotate(-45deg);
    }

    /* --- the overlay --- */

    /* Paper, not glass. Safari won't let a page paint behind its toolbar, so
       a dark overlay always left a bright strip along the edges no matter how
       it was tinted. Inverting it sidesteps the whole argument: the page is
       already white, so whatever the browser puts in those bars matches by
       default. It opens as a circle from the button that opened it. */
    .nav-drawer {
        position: fixed;
        inset: 0;
        z-index: 50;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding: 0 var(--gutter) calc(42px + env(safe-area-inset-bottom, 0px));
        color: var(--ink);
        /* Origin is written by lib/nav.ts from the toggle's own position. */
        clip-path: circle(0% at var(--ripple-x, 100%) var(--ripple-y, 32px));
        visibility: hidden;
        transition:
            clip-path 0.58s var(--ease),
            visibility 0s linear 0.58s;
    }

    /* The sheet's paper is an absolute child, not a background on the fixed
       element itself. iOS 26 Safari tints its bars from the background-color
       of fixed viewport-wide elements — even `visibility: hidden` ones — and
       a white sample here would fight the ink-dark bars the rest of the page
       asks for. Absolute children are not sampled; the look is identical. */
    .nav-drawer::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        background: var(--paper);
    }

    .nav-drawer.is-open {
        clip-path: circle(150% at var(--ripple-x, 100%) var(--ripple-y, 32px));
        visibility: visible;
        transition:
            clip-path 0.58s var(--ease),
            visibility 0s;
    }

    .nav-menu {
        display: flex;
        flex-direction: column;
    }

    .nav-menu a {
        display: flex;
        align-items: baseline;
        gap: 16px;
        padding: 14px 0;
        border-top: 1px solid var(--rule);
        font-family: var(--serif);
        font-size: clamp(30px, 9vw, 44px);
        line-height: 1;
        color: var(--ink);
        /* Each line comes up a beat after the one above it. */
        transform: translateY(26px);
        opacity: 0;
        transition:
            transform 0.5s var(--ease),
            opacity 0.4s var(--ease);
    }

    .nav-drawer.is-open .nav-menu a {
        transform: none;
        opacity: 1;
        transition-delay: calc(60ms * var(--i));
    }

    .nav-menu a:hover {
        color: var(--ink);
    }

    .nav-menu-index {
        color: rgba(20, 20, 20, 0.4);
    }

    /* `.pill` is built for the dark sections; on paper it has to invert. */
    .nav-menu-foot .pill {
        border-color: rgba(20, 20, 20, 0.24);
        color: var(--ink);
    }

    .nav-menu-foot .pill:hover {
        background: var(--ink);
        border-color: var(--ink);
        color: var(--paper);
    }

    .nav-menu-foot {
        display: flex;
        gap: 10px;
        margin-top: 30px;
        transform: translateY(26px);
        opacity: 0;
        transition:
            transform 0.5s var(--ease),
            opacity 0.4s var(--ease);
    }

    .nav-drawer.is-open .nav-menu-foot {
        transform: none;
        opacity: 1;
        transition-delay: 260ms;
    }

    @media (max-width: 900px) {
        .nav {
            height: 64px;
        }

        .nav-links {
            display: none;
        }

        .nav-toggle {
            display: block;
        }
    }

    /* Wide enough for the inline labels, so there is nothing to open. */
    @media (min-width: 901px) {
        .nav-drawer {
            display: none;
        }
    }
</style>
