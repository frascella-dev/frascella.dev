---
// The closing section, and the only part of the page that talks to a server.
// The form posts to the API; `lib/contact.ts` owns the submit, the 422
// field errors and the 429 backoff. `website` is the honeypot the API expects
// — it has to reach the request body, so it is hidden from sight and from
// assistive tech rather than removed.
import { owner } from "../data/site.ts";
import { getContent, toLocale } from "../i18n/index.ts";
import Footer from "./Footer.astro";

const locale = toLocale(Astro.currentLocale);
const t = getContent(locale);

const fields = [
    { key: "name", index: "01", type: "text" },
    { key: "email", index: "02", type: "email" },
    { key: "message", index: "03", type: "textarea" },
] as const;

// Everything lib/contact.ts says out loud, handed over on the element it
// already queries. The script holds no copy of its own — which is the only
// way a status line can be right in a language the bundle has never seen.
// `locale` rides along too: the API validates server-side and returns the
// messages it wants printed, so it has to be told which language to print in.
const formCopy = { locale, ...t.contact.status, errors: t.contact.errors };
---

<section id="contact" class="contact" data-cursor-scheme="dark">
    <div class="section-head label contact-head">
        <span style="color:#fff">{t.contact.eyebrow}</span>
        <span>{t.owner.city} · {owner.timezone}</span>
    </div>

    <div class="contact-grid">
        <div class="contact-intro">
            <h2 data-reveal class="contact-title">
                {t.contact.titleLead} <span class="dim">{t.contact.titleDim}</span>
            </h2>
            <p class="contact-lede">{t.contact.lede}</p>
            {/* github and linkedin used to sit here as two pills. The footer
                below lists them, a few hundred pixels down and on every page
                rather than just this one — two sets of the same two links on
                one screen was the reader being asked the same question twice. */}
        </div>

        <form data-contact-form data-copy={JSON.stringify(formCopy)} class="contact-form" novalidate>
            {
                fields.map((f) => (
                    <label data-field class="cfield">
                        <span class="label cfield-label">
                            {f.index} / {t.contact.fields[f.key]}
                        </span>
                        {f.type === "textarea" ? (
                            <textarea
                                name={f.key}
                                rows="4"
                                required
                                placeholder={t.contact.placeholders[f.key]}
                                aria-describedby={`err-${f.key}`}
                            />
                        ) : (
                            <input
                                name={f.key}
                                type={f.type}
                                required
                                placeholder={t.contact.placeholders[f.key]}
                                aria-describedby={`err-${f.key}`}
                            />
                        )}
                        <span data-error-for={f.key} id={`err-${f.key}`} class="cfield-error" />
                    </label>
                ))
            }

            <div class="cfield-honeypot" aria-hidden="true">
                <label>
                    {t.contact.honeypot}
                    <input name="website" type="text" tabindex="-1" autocomplete="off" />
                </label>
            </div>

            <div class="contact-actions">
                <button data-submit type="submit">{t.contact.submit}</button>
                <span data-form-status class="contact-status" role="status" aria-live="polite"></span>
            </div>
        </form>
    </div>

    {/* "no trackers, no cookie banner" used to be the third line here, and it
        was true right up until the site started counting its own visits. It
        now points at the page that says what it counts — which is the only
        version of that claim worth making. */}
    <Footer />
</section>

<style is:global>
    .contact {
        position: relative;
        /* At least one full viewport, always. The work stage is a fixed
           overlay that only stands down once the top of the viewport clears
           the work section — if contact were shorter than the screen, the
           page would bottom out with the stage still covering it. The spare
           96px is slack, so clearing the stage doesn't come down to the very
           last pixel of the document. */
        min-height: calc(100vh + 96px);
        /* Last section on the page, so its bottom padding is the one place
           that has to clear both the home indicator and Safari's bottom URL
           bar — see the `@supports` block below for the second part. */
        padding: 15vh var(--gutter) 7vh;
        background: var(--dark);
        color: #fff;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .contact-head {
        border-top-color: var(--rule-dark);
        color: rgba(255, 255, 255, 0.5);
    }

    .contact-grid {
        position: relative;
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 24px;
        margin: 8vh 0 14vh;
        align-items: start;
    }

    .contact-intro {
        grid-column: 1 / span 5;
    }

    .contact-title {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(46px, 7vw, 116px);
        line-height: 1;
        color: #fff;
    }

    .contact-title .dim {
        opacity: 0.4;
    }

    .contact-lede {
        margin-top: 34px;
        max-width: 34ch;
        font-size: 15.5px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.62);
        text-wrap: pretty;
    }

    .contact-form {
        grid-column: 7 / span 6;
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    .cfield {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .cfield-label {
        color: rgba(255, 255, 255, 0.5);
    }

    .cfield input,
    .cfield textarea {
        border: 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.26);
        background: transparent;
        padding: 10px 0;
        font-size: 20px;
        color: #fff;
        outline: none;
        transition: border-color 0.3s ease;
    }

    .cfield textarea {
        resize: none;
    }

    .cfield input::placeholder,
    .cfield textarea::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }

    .cfield input:focus,
    .cfield textarea:focus {
        border-bottom-color: #fff;
    }

    .cfield[data-invalid] input,
    .cfield[data-invalid] textarea {
        border-bottom-color: var(--accent);
    }

    .cfield-error {
        min-height: 0;
        font-weight: 500;
        font-size: 10px;
        letter-spacing: 0.16em;
        color: var(--accent);
    }

    .cfield-error:empty {
        display: none;
    }

    /* Off-screen rather than display:none — a hidden input still has to be
       submitted for the honeypot to mean anything. */
    .cfield-honeypot {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    .contact-actions {
        display: flex;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .contact-actions button {
        border: 0;
        background: #fff;
        color: var(--dark);
        padding: 16px 30px;
        border-radius: 999px;
        font-weight: 500;
        font-size: 10px;
        letter-spacing: 0.2em;
        cursor: pointer;
        transition: background 0.3s ease;
    }

    .contact-actions button:hover:not(:disabled) {
        background: var(--accent);
    }

    .contact-actions button:disabled {
        opacity: 0.55;
        cursor: default;
    }

    .contact-status {
        font-weight: 500;
        font-size: 10px;
        letter-spacing: 0.16em;
        color: var(--accent);
    }

    .contact-status[data-kind="error"] {
        color: oklch(0.72 0.15 30);
    }

    @media (max-width: 900px) {
        .contact {
            padding: 12vh var(--gutter) 7vh;
        }

        .contact-grid {
            grid-template-columns: 1fr;
            gap: 8vh;
            margin: 6vh 0 10vh;
        }

        .contact-intro,
        .contact-form {
            grid-column: 1;
        }
    }

</style>
