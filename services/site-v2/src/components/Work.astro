---
// Six-and-a-bit viewports of scroll driving one fixed stage. As the section
// arrives, a dark circle irises open over the paper page; inside it a three.js
// camera tracks sideways past the project slabs; on the way out the camera
// pulls back and the GitHub link takes the frame. The tail keeps the black
// behind the stage once it un-pins, so the hand-off into contact is seamless.
//
// `.work-fallback` is the whole section without any of that: it is what a
// reader gets with JavaScript off or reduced motion on, and it carries the
// same three projects as real, crawlable text.
import { projects, owner } from "../data/site.ts";
import ArrowUpRight from "./ArrowUpRight.astro";
---

<section id="work" data-work class="work">
    <div class="work-tail"></div>

    <div data-work-stage class="work-stage">
        <div data-ripple class="work-ripple" data-cursor-scheme="dark">
            <canvas data-three class="work-canvas"></canvas>

            <div data-work-copy class="work-eyebrow label">
                <span style="color:#fff">02 — selected work</span>
                <span data-work-counter>01 / {String(projects.length).padStart(2, "0")}</span>
            </div>

            <div data-work-copy class="work-caption">
                <div data-work-title class="work-title">{projects[0].title}</div>
                <p data-work-desc class="work-desc">{projects[0].desc}</p>
                <div data-work-meta class="work-meta label">{projects[0].meta}</div>
            </div>

            <div data-work-copy class="work-progress">
                <div class="work-progress-track">
                    <span data-work-bar></span>
                </div>
                <div class="work-progress-hint">still going</div>
            </div>

            <div data-work-intro class="work-intro">
                <div class="label work-intro-eyebrow">02 — selected work</div>
                <div class="work-intro-line">
                    a few things i built <span class="dim">and still maintain</span>
                </div>
                <div class="label work-intro-eyebrow">worth the scroll</div>
            </div>

            <div data-work-outro class="work-outro">
                <div class="label work-intro-eyebrow">that's the shortlist</div>
                <div class="work-outro-line">more projects on</div>
                <a class="pill work-outro-link" href={owner.github} target="_blank" rel="noopener">
                    github.com/manuto276 <ArrowUpRight />
                </a>
            </div>
        </div>
    </div>

    <div class="work-fallback" data-cursor-scheme="dark">
        <div class="section-head label work-fallback-head">
            <span style="color:#fff">02 — selected work</span>
            <span>{String(projects.length).padStart(2, "0")} projects</span>
        </div>
        <ol class="work-list">
            {
                projects.map((p, i) => (
                    <li>
                        <span class="label work-list-index">
                            {String(i + 1).padStart(2, "0")}
                        </span>
                        <div>
                            <h3 class="work-list-title">{p.title}</h3>
                            <p class="work-list-desc">{p.desc}</p>
                            <div class="label work-list-meta">{p.meta}</div>
                        </div>
                    </li>
                ))
            }
        </ol>
        <a class="pill" href={owner.github} target="_blank" rel="noopener">
            github.com/manuto276 <ArrowUpRight />
        </a>
    </div>
</section>

<style is:global>
    .work {
        position: relative;
        background: transparent;
    }

    .work-tail,
    .work-stage {
        display: none;
    }

    /* The black band that stays put underneath the stage so the section can
       hand over to the (also black) contact section without a seam. */
    .work-tail {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        height: 120vh;
        background: var(--dark);
    }

    .work-stage {
        position: fixed;
        inset: 0;
        z-index: 30;
        overflow: hidden;
        visibility: hidden;
        pointer-events: none;
    }

    .work-ripple {
        position: absolute;
        inset: 0;
        background: var(--dark);
        clip-path: circle(0% at 50% 60%);
        will-change: clip-path;
    }

    .work-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
    }

    .work-eyebrow {
        opacity: 0;
        position: absolute;
        left: var(--gutter);
        top: 14vh;
        display: flex;
        gap: 26px;
        align-items: baseline;
        color: rgba(255, 255, 255, 0.5);
    }

    .work-caption {
        opacity: 0;
        position: absolute;
        left: var(--gutter);
        bottom: 12vh;
        width: min(40vw, 540px);
    }

    .work-title {
        font-family: var(--serif);
        font-size: clamp(40px, 6vw, 96px);
        line-height: 0.98;
        color: #fff;
    }

    .work-desc {
        margin-top: 16px;
        font-size: 15.5px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.64);
        text-wrap: pretty;
    }

    .work-meta {
        margin-top: 16px;
        color: rgba(255, 255, 255, 0.5);
    }

    .work-progress {
        opacity: 0;
        position: absolute;
        right: var(--gutter);
        bottom: 12vh;
        width: 190px;
    }

    .work-progress-track {
        position: relative;
        height: 1px;
        background: rgba(255, 255, 255, 0.22);
    }

    .work-progress-track span {
        position: absolute;
        left: 0;
        top: -1px;
        height: 3px;
        width: 0%;
        background: #fff;
    }

    .work-progress-hint {
        margin-top: 10px;
        font-weight: 500;
        font-size: 9px;
        letter-spacing: 0.2em;
        color: rgba(255, 255, 255, 0.45);
        text-align: right;
    }

    .work-intro,
    .work-outro {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        pointer-events: none;
    }

    .work-intro {
        gap: min(2vw, 26px);
        padding: 0 8vw;
    }

    .work-outro {
        gap: 30px;
        opacity: 0;
    }

    .work-intro-eyebrow {
        letter-spacing: 0.24em;
        color: rgba(255, 255, 255, 0.5);
    }

    .work-intro-line {
        font-family: var(--serif);
        font-size: clamp(32px, 5vw, 86px);
        line-height: 1.08;
        color: #fff;
        max-width: 24ch;
    }

    .work-intro-line .dim {
        opacity: 0.42;
    }

    .work-outro-line {
        font-family: var(--serif);
        font-size: clamp(34px, 4.6vw, 78px);
        line-height: 1.1;
        color: #fff;
    }

    .work-outro-link {
        padding: 16px 30px;
        font-size: 11px;
        letter-spacing: 0.2em;
        border-color: rgba(255, 255, 255, 0.3);
    }

    /* --- the no-JS / reduced-motion reading of the same section --- */

    .work-fallback {
        background: var(--dark);
        color: #fff;
        padding: 14vh var(--gutter);
    }

    .work-fallback-head {
        border-top-color: var(--rule-dark);
        color: rgba(255, 255, 255, 0.5);
    }

    .work-list {
        list-style: none;
        margin: 7vh 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6vh;
    }

    .work-list li {
        display: grid;
        grid-template-columns: 4vw minmax(0, 1fr);
        gap: 2vw;
        border-top: 1px solid var(--rule-dark);
        padding-top: 24px;
    }

    .work-list-index {
        color: rgba(255, 255, 255, 0.5);
    }

    .work-list-title {
        font-family: var(--serif);
        font-weight: 400;
        font-size: clamp(32px, 4.4vw, 68px);
        line-height: 1;
        color: #fff;
    }

    .work-list-desc {
        margin-top: 14px;
        max-width: 52ch;
        font-size: 15.5px;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.64);
        text-wrap: pretty;
    }

    .work-list-meta {
        margin-top: 14px;
        color: rgba(255, 255, 255, 0.5);
    }

    /* When the motion layer is running the corridor takes over and the
       plain list steps aside. Otherwise the list *is* the section. */
    /* Seven screens of scroll: roughly one to arrive, three to walk the
       projects, and the rest to hand over to contact. The exit was the part
       that was short — see EXIT_VH in lib/scroll.ts. */
    html.motion .work {
        height: 700vh;
    }

    html.motion .work-tail,
    html.motion .work-stage {
        display: block;
    }

    html.motion .work-fallback {
        display: none;
    }

    /* Four and a bit screens instead of seven. Three cards still get about a
       screen each to be read; it is the intro and the exit that tighten (see
       the *_VH constants in lib/scroll.ts). */
    @media (max-width: 900px), (pointer: coarse) {
        html.motion .work {
            height: 420vh;
        }
    }

    @media (max-width: 900px) {
        /* The caption takes the lower third and the card sits above it, so
           the two stop fighting over the middle of a tall, narrow frame. */
        .work-caption {
            width: calc(100% - var(--gutter) * 2);
            bottom: 9vh;
        }

        .work-title {
            font-size: clamp(38px, 13vw, 64px);
        }

        .work-desc {
            margin-top: 12px;
            font-size: 14px;
            max-width: 34ch;
        }

        .work-eyebrow {
            top: 11vh;
            gap: 16px;
        }

        /* A progress bar reading "scroll to orbit" is a mouse instruction,
           and the counter above already says where you are. */
        .work-progress {
            display: none;
        }

        .work-intro {
            padding: 0 var(--gutter);
        }

        .work-intro-line {
            font-size: clamp(30px, 9vw, 52px);
            max-width: 16ch;
        }

        .work-outro-line {
            font-size: clamp(30px, 9vw, 52px);
        }

        .work-fallback {
            padding: 12vh var(--gutter);
        }

        .work-list li {
            grid-template-columns: 30px minmax(0, 1fr);
            gap: 12px;
        }
    }
</style>
