# --- App ---
APP_NAME=frascella.dev
# "production" makes an unconfigured mailer a hard 503 instead of a logged no-op.
APP_ENV=development
# Analytics days and hours are bucketed in this zone, so the dashboard's
# "today" is the owner's today rather than UTC's.
APP_TIMEZONE=Europe/Rome

# Comma-separated allowed origins for CORS ("*" allows any).
# Cookies are only granted to an origin named explicitly here — under "*" the
# API still answers, but without credentials. In the deployed layout the site
# and the API are same-origin and none of this is used.
CORS_ORIGINS=http://localhost:5173

# --- Mail (SMTP) ---
# Leave MAIL_HOST empty in local dev to log messages instead of sending.
MAIL_HOST=
MAIL_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS on 587.
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=frascella.dev
# Recipient of contact form messages (the site owner).
MAIL_TO_ADDRESS=

# --- Database (analytics only) ---
# sqlite | mysql. SQLite is the default and needs nothing but a writable
# directory — the whole dataset is that one file. Needs ext-pdo_sqlite, or
# ext-pdo_mysql for the other driver.
DB_DRIVER=sqlite
# sqlite: a path; relative ones resolve against the app root.
# mysql:  the schema name.
DB_DATABASE=var/analytics.sqlite
# --- mysql only ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=

# Analytics rows older than this are deleted by bin/prune.php (cron).
ANALYTICS_RETENTION_DAYS=400

# --- Admin dashboard ---
# No password lives here. Accounts are rows, created with:
#   php bin/admin-user.php create you@example.com
# Two-factor is required; the command prints the TOTP secret and the recovery
# codes once. With no account, /admin exists but cannot be signed into.
