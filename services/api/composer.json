{
    "name": "portfolio/api",
    "description": "Emanuele Frascella — portfolio API (plain PHP). Handles contact form email delivery.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": {
            "Api\\": "src/"
        }
    },
    "scripts": {
        "dev": "php -S 0.0.0.0:3000 public/index.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
